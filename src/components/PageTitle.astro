---
/**
 * Custom PageTitle override for Starlight.
 * Renders the page title followed by LLM action buttons (Copy as Markdown, Open in Claude/ChatGPT, llms.txt links).
 */
---

<h1 id="_top">{Astro.locals.starlightRoute.entry.data.title}</h1>

<div class="llm-bar">
  <div class="llm-actions">
    <button class="llm-btn" id="copy-md-btn" title="Copy this page as Markdown">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
      <span id="copy-md-label">Copy as Markdown</span>
    </button>
    <a class="llm-btn" id="open-claude-btn" href="#" target="_blank" rel="noopener" title="Open in Claude">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      Open in Claude
    </a>
    <a class="llm-btn" id="open-chatgpt-btn" href="#" target="_blank" rel="noopener" title="Open in ChatGPT">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      Open in ChatGPT
    </a>
  </div>
  <div class="llm-links">
    <a href="/llms.txt" class="llm-link">llms.txt</a>
    <span class="llm-sep">/</span>
    <a href="/llms-full.txt" class="llm-link">llms-full.txt</a>
  </div>
</div>

<script>
  function getPageMarkdown(): string {
    const content = document.querySelector('[data-pagefind-body]') ||
                    document.querySelector('main') ||
                    document.querySelector('article');
    if (!content) return '';

    const clone = content.cloneNode(true) as HTMLElement;
    clone.querySelectorAll('nav, script, style, .llm-bar, footer').forEach(el => el.remove());

    const title = document.querySelector('h1')?.textContent?.trim() || document.title;
    const url = window.location.href;
    return `# ${title}\n\nSource: ${url}\n\n${clone.textContent?.trim() || ''}`;
  }

  document.addEventListener('DOMContentLoaded', () => {
    const copyBtn = document.getElementById('copy-md-btn');
    const copyLabel = document.getElementById('copy-md-label');
    const claudeBtn = document.getElementById('open-claude-btn') as HTMLAnchorElement | null;
    const chatgptBtn = document.getElementById('open-chatgpt-btn') as HTMLAnchorElement | null;

    if (copyBtn && copyLabel) {
      copyBtn.addEventListener('click', () => {
        const md = getPageMarkdown();
        navigator.clipboard.writeText(md).then(() => {
          copyLabel.textContent = 'Copied!';
          setTimeout(() => { copyLabel.textContent = 'Copy as Markdown'; }, 1500);
        });
      });
    }

    if (claudeBtn) {
      claudeBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const md = getPageMarkdown();
        window.open(`https://claude.ai/new?q=${encodeURIComponent(md)}`, '_blank');
      });
    }

    if (chatgptBtn) {
      chatgptBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const md = getPageMarkdown();
        window.open(`https://chatgpt.com/?q=${encodeURIComponent(md)}`, '_blank');
      });
    }
  });
</script>

<style>
  h1 {
    margin-top: 1rem;
    font-size: var(--sl-text-h1);
    line-height: var(--sl-line-height-headings);
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .llm-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.75rem;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }

  .llm-actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .llm-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    background: none;
    color: var(--sl-color-gray-3);
    border: 1px solid var(--sl-color-gray-5);
    padding: 0.3rem 0.6rem;
    font-size: 0.8rem;
    font-family: inherit;
    cursor: pointer;
    text-decoration: none;
    transition: color 0.15s, border-color 0.15s;
  }

  .llm-btn:hover {
    color: var(--sl-color-text-accent);
    border-color: var(--sl-color-text-accent);
  }

  .llm-btn svg {
    flex-shrink: 0;
  }

  .llm-links {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
  }

  .llm-link {
    color: var(--sl-color-gray-3);
    text-decoration: none;
    font-family: inherit;
    transition: color 0.15s;
  }

  .llm-link:hover {
    color: var(--sl-color-text-accent);
  }

  .llm-sep {
    color: var(--sl-color-gray-5);
  }
</style>
